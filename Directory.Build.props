<Project>

  <!--
    One version for the whole Windows port, in Semantic Versioning 2.0.0 form.
    The .NET SDK derives AssemblyVersion, FileVersion and InformationalVersion
    from this, so bumping a release means editing this one line.

    Override it for a one-off build or a CI run without touching the file:

        dotnet build AbesWorkLouderCreatorMicroStudio.Windows.sln -p:Version=0.4.2-rc.1

    What each version contains is recorded in CHANGELOG.md.
  -->
  <PropertyGroup>
    <Version>0.6.0</Version>
    <Product>Abe's WorkLouder Creator Micro Studio for Windows</Product>
    <Company>Abe</Company>
    <Authors>Abe</Authors>
  </PropertyGroup>

</Project>
