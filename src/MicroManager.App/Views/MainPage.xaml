<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tb="https://notifyicon.com/"
             x:Class="MicroManager.App.Views.MainPage"
             Title="Micro Manager">
    <Grid>
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="{Binding StatusText}"
            LeftClickCommand="{Binding ShowHideWindowCommand}"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="M"
                                        FontSize="34"
                                        Foreground="#FFFFFF"
                                        Background="#007ACC" />
            </tb:TaskbarIcon.IconSource>
            <FlyoutBase.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="{Binding VersionText}" IsEnabled="False" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{Binding ShowHideWindowCommand}" Text="Show / Hide Window" />
                    <MenuFlyoutItem Command="{Binding ToggleEnabledCommand}" Text="Toggle Bridge" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{Binding ExitApplicationCommand}" Text="Exit" />
                </MenuFlyout>
            </FlyoutBase.ContextFlyout>
        </tb:TaskbarIcon>

        <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30">
            <Label Text="Micro Manager"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource PrimaryColor}" />

            <Label Text="Work Louder Creator Micro 2 Bridge"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource SecondaryColor}" />

            <Label Text="{Binding VersionText}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource SecondaryColor}" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*" RowSpacing="10" ColumnSpacing="10" Margin="0,20,0,0">
                <Label Text="Status" Grid.Column="0" Grid.Row="0" FontAttributes="Bold" />
                <Label Text="{Binding StatusText}" Grid.Column="1" Grid.Row="0" />

                <Label Text="Device" Grid.Column="0" Grid.Row="1" FontAttributes="Bold" />
                <Label Text="{Binding IsConnected, StringFormat='{0:connected|disconnected}'}" Grid.Column="1" Grid.Row="1" />

                <Label Text="Bridge" Grid.Column="0" Grid.Row="2" FontAttributes="Bold" />
                <Label Text="{Binding IsEnabled, StringFormat='{0:enabled|disabled}'}" Grid.Column="1" Grid.Row="2" />
            </Grid>

            <Label Text="Pad keys" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,20,0,0" />

            <HorizontalStackLayout Spacing="5"
                                   HorizontalOptions="Center"
                                   BindableLayout.ItemsSource="{Binding KeyLights}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="2">
                            <BoxView WidthRequest="20"
                                     HeightRequest="20"
                                     CornerRadius="4"
                                     Color="{Binding Color}" />
                            <Label Text="{Binding KeyId}"
                                   FontSize="9"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource SecondaryColor}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <Label Text="{Binding LastAction}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource SecondaryColor}" />

            <Button Text="Toggle Bridge"
                    Command="{Binding ToggleEnabledCommand}"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0" />

            <CollectionView ItemsSource="{Binding Agents}"
                            Margin="0,20,0,0"
                            HeightRequest="180">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="5" BorderColor="{StaticResource SecondaryColor}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FocusCommand}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Label Text="{Binding ShortName}" FontAttributes="Bold" />
                                    <Label Text="{Binding DirectoryName}"
                                           FontSize="10"
                                           TextColor="{StaticResource SecondaryColor}" />
                                </VerticalStackLayout>
                                <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" Grid.Column="1" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--
                The macOS Inspector's lighting console, which is the only place
                in either implementation where a colour is chosen by hand: the
                menu-bar app paints from a compiled-in palette. Applying takes
                the lights off the bridge, or the next poll repaints over them.
            -->
            <BoxView HeightRequest="1" Color="{StaticResource SecondaryColor}" Margin="0,24,0,0" />
            <Label Text="Lights" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="By hand. Applying stops the bridge painting, so what you set stays."
                   FontSize="11" HorizontalOptions="Center" TextColor="{StaticResource SecondaryColor}" />

            <HorizontalStackLayout Spacing="6"
                                   HorizontalOptions="Center"
                                   BindableLayout.ItemsSource="{Binding Lights.Keys}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding Label}"
                                Command="{Binding SelectCommand}"
                                CommandParameter="{Binding .}"
                                WidthRequest="32"
                                HeightRequest="32"
                                Padding="0"
                                FontSize="11"
                                BackgroundColor="{Binding Background}"
                                TextColor="{Binding TextColor}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="Top 6" Command="{Binding Lights.SelectAgentKeysCommand}" FontSize="11" Padding="10,4" />
                <Button Text="All" Command="{Binding Lights.SelectAllCommand}" FontSize="11" Padding="10,4" />
                <Button Text="None" Command="{Binding Lights.SelectNoneCommand}" FontSize="11" Padding="10,4" />
                <Label Text="{Binding Lights.SelectionText}"
                       FontSize="11"
                       VerticalOptions="Center"
                       TextColor="{StaticResource SecondaryColor}" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Colour" FontSize="12" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                    <Entry Text="{Binding Lights.ColorHex}" WidthRequest="88" FontSize="12" />
                    <Button Text="red" Command="{Binding Lights.UseColorCommand}" CommandParameter="#FF2D2D" FontSize="10" Padding="6,2" TextColor="#FF2D2D" />
                    <Button Text="amber" Command="{Binding Lights.UseColorCommand}" CommandParameter="#FFA000" FontSize="10" Padding="6,2" TextColor="#FFA000" />
                    <Button Text="blue" Command="{Binding Lights.UseColorCommand}" CommandParameter="#00B0FF" FontSize="10" Padding="6,2" TextColor="#00B0FF" />
                    <Button Text="green" Command="{Binding Lights.UseColorCommand}" CommandParameter="#00C853" FontSize="10" Padding="6,2" TextColor="#00C853" />
                    <Button Text="violet" Command="{Binding Lights.UseColorCommand}" CommandParameter="#7C4DFF" FontSize="10" Padding="6,2" TextColor="#7C4DFF" />
                    <Button Text="white" Command="{Binding Lights.UseColorCommand}" CommandParameter="#FFFFFF" FontSize="10" Padding="6,2" TextColor="#FFFFFF" />
                </HorizontalStackLayout>

                <Label Grid.Row="1" Grid.Column="0" Text="Effect" FontSize="12" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1"
                        FontSize="12"
                        ItemsSource="{Binding Lights.Effects}"
                        SelectedItem="{Binding Lights.Effect}" />

                <Label Grid.Row="2" Grid.Column="0" Text="Brightness" FontSize="12" VerticalOptions="Center" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,44">
                    <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Lights.Brightness}" />
                    <Label Grid.Column="1" Text="{Binding Lights.BrightnessText}" FontSize="11" VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="3" Grid.Column="0" Text="Speed" FontSize="12" VerticalOptions="Center" />
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,44">
                    <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Lights.Speed}" />
                    <Label Grid.Column="1" Text="{Binding Lights.SpeedText}" FontSize="11" VerticalOptions="Center" />
                </Grid>
            </Grid>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="Apply to selected" Command="{Binding Lights.ApplySelectedCommand}" FontSize="11" Padding="10,4" />
                <Button Text="Clear selected" Command="{Binding Lights.ClearSelectedCommand}" FontSize="11" Padding="10,4" />
                <Button Text="Whole keys zone" Command="{Binding Lights.ApplyKeysZoneCommand}" FontSize="11" Padding="10,4" />
            </HorizontalStackLayout>

            <Label Text="Underglow" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,12,0,0" />

            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Colour" FontSize="12" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                    <Entry Text="{Binding Lights.AmbientColorHex}" WidthRequest="88" FontSize="12" />
                    <Button Text="green" Command="{Binding Lights.UseAmbientColorCommand}" CommandParameter="#00C853" FontSize="10" Padding="6,2" TextColor="#00C853" />
                    <Button Text="red" Command="{Binding Lights.UseAmbientColorCommand}" CommandParameter="#FF2D2D" FontSize="10" Padding="6,2" TextColor="#FF2D2D" />
                    <Button Text="blue" Command="{Binding Lights.UseAmbientColorCommand}" CommandParameter="#00B0FF" FontSize="10" Padding="6,2" TextColor="#00B0FF" />
                    <Button Text="off" Command="{Binding Lights.UseAmbientColorCommand}" CommandParameter="#000000" FontSize="10" Padding="6,2" />
                </HorizontalStackLayout>

                <Label Grid.Row="1" Grid.Column="0" Text="Effect" FontSize="12" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1"
                        FontSize="12"
                        ItemsSource="{Binding Lights.Effects}"
                        SelectedItem="{Binding Lights.AmbientEffect}" />

                <Label Grid.Row="2" Grid.Column="0" Text="Brightness" FontSize="12" VerticalOptions="Center" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,44">
                    <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Lights.AmbientBrightness}" />
                    <Label Grid.Column="1" Text="{Binding Lights.AmbientBrightnessText}" FontSize="11" VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="3" Grid.Column="0" Text="Speed" FontSize="12" VerticalOptions="Center" />
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,44">
                    <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Lights.AmbientSpeed}" />
                    <Label Grid.Column="1" Text="{Binding Lights.AmbientSpeedText}" FontSize="11" VerticalOptions="Center" />
                </Grid>
            </Grid>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="Apply underglow" Command="{Binding Lights.ApplyUnderglowCommand}" FontSize="11" Padding="10,4" />
                <Button Text="All lights off" Command="{Binding Lights.AllOffCommand}" FontSize="11" Padding="10,4" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0">
                <Switch IsToggled="{Binding Lights.IsManual}" />
                <Label Text="Take the lights off the bridge" FontSize="12" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
