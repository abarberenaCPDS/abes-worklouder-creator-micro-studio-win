<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MicroManager.App</RootNamespace>
    <AssemblyName>MicroManager.App</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsSdkPackageVersion>10.0.22621.38</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The CsWinRT AOT source generator emits unsafe code into the project,
         so any change to the app's sources re-emits a file that will not
         compile without this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\appicon.svg" Color="#007ACC" />
    <MauiSplashScreen Include="Resources\appicon.svg" Color="#007ACC" BaseSize="128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.10" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.10" />
    <PackageReference Include="H.NotifyIcon.Maui" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicroManager.Core\MicroManager.Core.csproj" />
    <ProjectReference Include="..\MicroManager.Transport.Winrt\MicroManager.Transport.Winrt.csproj" />
  </ItemGroup>

</Project>
