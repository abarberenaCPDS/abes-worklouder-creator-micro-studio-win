<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MicroManager.App</RootNamespace>
    <AssemblyName>MicroManager.App</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsSdkPackageVersion>10.0.22621.38</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\appicon.svg" Color="#007ACC" />
    <MauiSplashScreen Include="Resources\appicon.svg" Color="#007ACC" BaseSize="128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.10" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicroManager.Core\MicroManager.Core.csproj" />
    <ProjectReference Include="..\MicroManager.Transport.Winrt\MicroManager.Transport.Winrt.csproj" />
    <None Include="Platforms\Windows\Package.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="MauiProgram.cs" />
    <Compile Include="Views\MainPage.xaml.cs" />
    <Compile Include="Platforms\Windows\Win32.cs" />
    <Compile Include="Services\BridgeService.cs" />
    <Compile Include="ViewModels\TrayIconViewModel.cs" />
    <None Include="Properties\launchSettings.json" />
  </ItemGroup>

</Project>
