<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AbesWorkLouderCreatorMicroStudio.Windows.Views.HerdrPage">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <!-- Header -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Herdr" Style="{StaticResource PageTitle}" />
                <Label Text="Live agent order, pad slot mapping, and host-side input actions. This page does not write the device keymap."
                       Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <!-- Connection context -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="CONNECTION CONTEXT" Style="{StaticResource CardEyebrow}" />
                    <Label Text="Transport" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding TransportContext}" Style="{StaticResource ValueLabel}"
                           LineBreakMode="CharacterWrap" />
                    <Label Text="Socket path" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding SocketPath}" Style="{StaticResource ValueLabel}"
                           LineBreakMode="CharacterWrap" />
                    <Label Text="{Binding MetadataStatus}" Style="{StaticResource StatusWarnLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Agents and pad slots -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="AGENTS AND PAD SLOTS" Style="{StaticResource CardEyebrow}" />
                    <Label Text="Agents stay in Herdr server order. The first six map to the pad's six agent slots; click a row to request focus in Herdr."
                           Style="{StaticResource CaptionLabel}" />
                    <Label Text="{Binding AgentStatus}" Style="{StaticResource CaptionLabel}" />

                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Agents}">
                        <BindableLayout.EmptyView>
                            <Label Text="No agent snapshot yet." Style="{StaticResource CaptionLabel}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerRow}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                                          ColumnSpacing="12" RowSpacing="6">
                                        <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6"
                                                 Color="{Binding StatusColor}" VerticalOptions="Start"
                                                 Margin="0,4,0,0" />
                                        <Label Grid.Column="1" Text="{Binding Name}"
                                               Style="{StaticResource SectionTitle}" />
                                        <Button Grid.Column="2" Text="Focus"
                                                Command="{Binding FocusCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SecondaryButton}"
                                                VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="3">
                                            <Label Text="{Binding State}" Style="{StaticResource CaptionLabel}" />
                                            <Label Text="{Binding Location}" Style="{StaticResource CaptionLabel}"
                                                   LineBreakMode="CharacterWrap" />
                                            <Label Text="{Binding SlotSummary}" Style="{StaticResource ValueLabel}" />
                                            <Label Text="{Binding SlotAction}" Style="{StaticResource CaptionLabel}"
                                                   IsVisible="{Binding HasSlot}" />
                                            <Label Text="{Binding InputAvailability}" Style="{StaticResource StatusWarnLabel}"
                                                   IsVisible="{Binding IsInputUnavailable}" />
                                            <Label Text="{Binding FocusIndicator}" Style="{StaticResource AccentLabel}"
                                                   IsVisible="{Binding Agent.Focused}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding FocusStatus}" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Physical input mappings -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="PHYSICAL INPUT MAPPINGS" Style="{StaticResource CardEyebrow}" />
                    <Label Text="These are host-side actions from the current bindings. Availability is reported for the active device profile; unavailable inputs may not emit events."
                           Style="{StaticResource CaptionLabel}" />
                    <Label Text="{Binding InputStatus}" Style="{StaticResource StatusWarnLabel}" />

                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Inputs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerRow}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="8" RowSpacing="3">
                                        <Label Text="{Binding Name}" Style="{StaticResource ValueLabel}"
                                               FontAttributes="Bold" />
                                        <Label Grid.Column="1" Grid.RowSpan="3" Text="{Binding Availability}"
                                               Style="{StaticResource StatusWarnLabel}" VerticalOptions="Center"
                                               IsVisible="{Binding IsUnavailable}" />
                                        <Label Grid.Row="1" Text="{Binding Descriptor}" Style="{StaticResource CaptionLabel}" />
                                        <Label Grid.Row="2" Text="{Binding Action}" Style="{StaticResource ValueLabel}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
