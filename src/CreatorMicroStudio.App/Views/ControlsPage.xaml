<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AbesWorkLouderCreatorMicroStudio.Windows.Controls"
             x:Class="AbesWorkLouderCreatorMicroStudio.Windows.Views.ControlsPage">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Controls" Style="{StaticResource PageTitle}" />
                    <Label Text="Choose an input on the pad or by name, then edit the action it runs."
                           Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Style="{StaticResource TightCard}" Padding="12,7"
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding CustomizedSummary}" Style="{StaticResource ValueLabel}"
                               HorizontalTextAlignment="End" />
                        <Label Text="custom actions" Style="{StaticResource CaptionLabel}"
                               HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="1.12*,0.95*" ColumnSpacing="16" RowDefinitions="Auto">
                <!-- The pad is the primary selector; named groups provide an alternate path. -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Choose a physical input" Style="{StaticResource CardEyebrow}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Click to select" Style="{StaticResource CaptionLabel}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <controls:PadMapView x:Name="PadMap"
                                             HeightRequest="340"
                                             Selection="{Binding SelectionIds}"
                                             Bindings="{Binding Bindings}"
                                             AgentNames="{Binding AgentNames}"
                                             KeyColors="{Binding KeyColors}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding SelectionSummary}" Style="{StaticResource AccentLabel}" />
                                <Label Text="{Binding SelectedSubtitle}" Style="{StaticResource CaptionLabel}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding SelectedCount, StringFormat='{0} selected'}"
                                   Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource StudioDivider}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Quick select" Style="{StaticResource CardEyebrow}" />
                                <Label Text="Select by name when the pad position is unclear."
                                       Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Button Text="Select all" Command="{Binding SelectAllCommand}"
                                        Style="{StaticResource ChipButton}" />
                                <Button Text="Clear" Command="{Binding ClearSelectionCommand}"
                                        Style="{StaticResource ChipButton}" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Label Text="Keys" Style="{StaticResource FieldLabel}" />
                        <FlexLayout Direction="Row" Wrap="Wrap" AlignContent="Start" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding KeyInputs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                            AutomationProperties.HelpText="{Binding ActionSummary}"
                                            Command="{Binding ToggleCommand}"
                                            Style="{StaticResource ChipButton}"
                                            WidthRequest="88" HeightRequest="38" Padding="6,0"
                                            Margin="0,0,6,6">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource StudioSelection}" />
                                                <Setter Property="BorderColor" Value="{StaticResource StudioAccent}" />
                                                <Setter Property="TextColor" Value="{StaticResource StudioText}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Label Text="Dial" Style="{StaticResource FieldLabel}" />
                        <FlexLayout Direction="Row" Wrap="Wrap" AlignContent="Start" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding DialInputs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding ShortName}" AutomationProperties.Name="{Binding Name}"
                                            AutomationProperties.HelpText="{Binding ActionSummary}"
                                            Command="{Binding ToggleCommand}"
                                            Style="{StaticResource ChipButton}"
                                            HeightRequest="38" Padding="10,0" Margin="0,0,6,6">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource StudioSelection}" />
                                                <Setter Property="BorderColor" Value="{StaticResource StudioAccent}" />
                                                <Setter Property="TextColor" Value="{StaticResource StudioText}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Label Text="Joystick" Style="{StaticResource FieldLabel}" />
                        <FlexLayout Direction="Row" Wrap="Wrap" AlignContent="Start" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding JoystickInputs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding ShortName}" AutomationProperties.Name="{Binding Name}"
                                            AutomationProperties.HelpText="{Binding ActionSummary}"
                                            Command="{Binding ToggleCommand}"
                                            Style="{StaticResource ChipButton}"
                                            HeightRequest="38" Padding="10,0" Margin="0,0,6,6">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource StudioSelection}" />
                                                <Setter Property="BorderColor" Value="{StaticResource StudioAccent}" />
                                                <Setter Property="TextColor" Value="{StaticResource StudioText}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding CapabilitySummary}"
                               IsVisible="{Binding HasCapabilityWarnings}"
                               Style="{StaticResource StatusWarnLabel}" />
                    </VerticalStackLayout>
                </Border>

                <!-- A persistent details pane keeps the current action in view. -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Action editor" Style="{StaticResource CardEyebrow}" />
                                <Label Text="{Binding SelectedTitle}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding SelectedSubtitle}" Style="{StaticResource CaptionLabel}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource InnerRow}" Padding="9,5"
                                    VerticalOptions="Start">
                                <Label Text="{Binding SelectionSummary}" Style="{StaticResource CaptionLabel}"
                                       LineBreakMode="TailTruncation" />
                            </Border>
                        </Grid>
                        <BoxView Style="{StaticResource StudioDivider}" />

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="10" RowSpacing="9">
                            <Label Text="Action" Style="{StaticResource FieldLabel}" />
                            <Picker Grid.Column="1" ItemsSource="{Binding ActionKinds}"
                                    SelectedItem="{Binding SelectedActionKind}"
                                    Style="{StaticResource StudioPicker}" />

                            <Label Grid.Row="1" Text="Agent slot" IsVisible="{Binding IsSlotVisible}"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Slot}"
                                   IsVisible="{Binding IsSlotVisible}" Keyboard="Numeric"
                                   Placeholder="1–13" Style="{StaticResource StudioEntry}" />

                            <Label Grid.Row="2" Text="Direction" IsVisible="{Binding IsDirectionVisible}"
                                   Style="{StaticResource FieldLabel}" />
                            <Picker Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Directions}"
                                    SelectedItem="{Binding SelectedDirection}"
                                    IsVisible="{Binding IsDirectionVisible}"
                                    Style="{StaticResource StudioPicker}" />

                            <Label Grid.Row="3" Text="Amount" IsVisible="{Binding IsAmountVisible}"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry Grid.Row="3" Grid.Column="1" Text="{Binding Amount}"
                                   IsVisible="{Binding IsAmountVisible}" Keyboard="Numeric"
                                   Placeholder="1–20 lines" Style="{StaticResource StudioEntry}" />

                            <Label Grid.Row="4" Text="Media key" IsVisible="{Binding IsMediaVisible}"
                                   Style="{StaticResource FieldLabel}" />
                            <Picker Grid.Row="4" Grid.Column="1" ItemsSource="{Binding MediaKeys}"
                                    SelectedItem="{Binding SelectedMediaKey}"
                                    IsVisible="{Binding IsMediaVisible}"
                                    Style="{StaticResource StudioPicker}" />
                        </Grid>

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsValueVisible}">
                            <Label Text="{Binding ValueFieldLabel}" Style="{StaticResource FieldLabel}" />
                            <Editor Text="{Binding Value}"
                                    Placeholder="{Binding ValueFieldPlaceholder}"
                                    AutoSize="TextChanges" MinimumHeightRequest="92"
                                    Style="{StaticResource StudioEditor}" />
                            <Label Text="Keys and shortcuts use host action syntax, for example ctrl+c esc."
                                   IsVisible="{Binding IsKeysValue}"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource StudioDivider}" />
                        <Label Text="{Binding Status}" Style="{StaticResource CaptionLabel}"
                               LineBreakMode="WordWrap" />
                        <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                            <Button Text="Apply to selected" Command="{Binding ApplyCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" />
                            <Button Text="Reset default" Command="{Binding ResetCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" />
                            <Button Text="Test" Command="{Binding TestCommand}"
                                    Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Host-side only: layout edits never rewrite the device keymap. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Agent layout" Style="{StaticResource CardEyebrow}" />
                            <Label Text="{Binding AgentLayoutSummary}" Style="{StaticResource SectionTitle}" />
                            <Label Text="Any of the thirteen keycaps can be an agent slot. Slots follow physical reading order; a custom action on a layout key still runs instead of focusing its slot. The device keymap is never rewritten."
                                   Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Start">
                            <Button Text="Apply layout" Command="{Binding ApplyAgentLayoutCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Text="Reset to default" Command="{Binding ResetAgentLayoutCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6"
                                         BindableLayout.ItemsSource="{Binding AgentLayoutRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="6"
                                                       BindableLayout.ItemsSource="{Binding Keys}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Button Text="{Binding ButtonText}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    AutomationProperties.HelpText="{Binding HelpText}"
                                                    Command="{Binding ToggleCommand}"
                                                    Style="{StaticResource ChipButton}"
                                                    WidthRequest="84" HeightRequest="38" Padding="6,0"
                                                    Margin="0">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsAgentKey}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource StudioSelection}" />
                                                        <Setter Property="BorderColor" Value="{StaticResource StudioAccent}" />
                                                        <Setter Property="BorderWidth" Value="1" />
                                                        <Setter Property="TextColor" Value="{StaticResource StudioText}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding TakesPrecedence}" Value="True">
                                                        <Setter Property="BorderColor" Value="{StaticResource StudioAmber}" />
                                                        <Setter Property="BorderWidth" Value="1" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding AgentLayoutStatus}" Style="{StaticResource CaptionLabel}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
