<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tb="https://notifyicon.com/"
             xmlns:controls="clr-namespace:AbesWorkLouderCreatorMicroStudio.Windows.Controls"
             x:Class="AbesWorkLouderCreatorMicroStudio.Windows.Views.MainPage"
             Title="Abe's WorkLouder Creator Micro Studio for Windows">
    <Grid ColumnDefinitions="248,*" BackgroundColor="{StaticResource StudioBackground}">
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Grid.ColumnSpan="2"
            IconSource="/Images/studio_icon.ico"
            ToolTipText="{Binding StatusText}"
            LeftClickCommand="{Binding ShowHideWindowCommand}"
            NoLeftClickDelay="True">
            <FlyoutBase.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="{Binding VersionText}" IsEnabled="False" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{Binding ShowHideWindowCommand}" Text="Show / Hide Window" />
                    <MenuFlyoutItem Command="{Binding ToggleEnabledCommand}" Text="Toggle Bridge" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{Binding ExitApplicationCommand}" Text="Exit" />
                </MenuFlyout>
            </FlyoutBase.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- Sidebar rail -->
        <Border Grid.Column="0"
                BackgroundColor="{StaticResource StudioSidebar}"
                StrokeThickness="0"
                Padding="16,20">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
                <VerticalStackLayout Grid.Row="0" Spacing="3">
                    <Label Text="ABE'S STUDIO" Style="{StaticResource CardEyebrow}" />
                    <Label Text="Creator Micro Studio" Style="{StaticResource SectionTitle}" FontSize="19" />
                    <Label Text="for Windows" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="4">
                    <Border Style="{StaticResource NavItem}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigatePageCommand}" CommandParameter="Studio" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedPage}" Value="Studio">
                                <Setter Property="BackgroundColor" Value="{StaticResource StudioSelection}" />
                                <Setter Property="Stroke" Value="{StaticResource StudioAccent}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   TextColor="{StaticResource StudioTextMuted}" VerticalOptions="Center" />
                            <Label Text="Studio" Style="{StaticResource ValueLabel}" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border Style="{StaticResource NavItem}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigatePageCommand}" CommandParameter="Controls" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedPage}" Value="Controls">
                                <Setter Property="BackgroundColor" Value="{StaticResource StudioSelection}" />
                                <Setter Property="Stroke" Value="{StaticResource StudioAccent}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   TextColor="{StaticResource StudioTextMuted}" VerticalOptions="Center" />
                            <Label Text="Controls" Style="{StaticResource ValueLabel}" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border Style="{StaticResource NavItem}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigatePageCommand}" CommandParameter="Lighting" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedPage}" Value="Lighting">
                                <Setter Property="BackgroundColor" Value="{StaticResource StudioSelection}" />
                                <Setter Property="Stroke" Value="{StaticResource StudioAccent}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   TextColor="{StaticResource StudioTextMuted}" VerticalOptions="Center" />
                            <Label Text="Lighting" Style="{StaticResource ValueLabel}" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border Style="{StaticResource NavItem}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigatePageCommand}" CommandParameter="Herdr" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedPage}" Value="Herdr">
                                <Setter Property="BackgroundColor" Value="{StaticResource StudioSelection}" />
                                <Setter Property="Stroke" Value="{StaticResource StudioAccent}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   TextColor="{StaticResource StudioTextMuted}" VerticalOptions="Center" />
                            <Label Text="Herdr" Style="{StaticResource ValueLabel}" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border Style="{StaticResource NavItem}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigatePageCommand}" CommandParameter="Inspector" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedPage}" Value="Inspector">
                                <Setter Property="BackgroundColor" Value="{StaticResource StudioSelection}" />
                                <Setter Property="Stroke" Value="{StaticResource StudioAccent}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   TextColor="{StaticResource StudioTextMuted}" VerticalOptions="Center" />
                            <Label Text="Inspector" Style="{StaticResource ValueLabel}" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3" Spacing="9">
                    <BoxView Style="{StaticResource StudioDivider}" />
                    <HorizontalStackLayout Spacing="8">
                        <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                 Color="{Binding ConnectionColor}" VerticalOptions="Center" />
                        <Label Text="{Binding StatusText}" Style="{StaticResource CaptionLabel}" LineBreakMode="TailTruncation" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding VersionText}" Style="{StaticResource CaptionLabel}"
                           TextColor="{StaticResource StudioTextFaint}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Studio dashboard -->
        <ScrollView Grid.Column="1" IsVisible="{Binding IsStudioPage}">
            <VerticalStackLayout Padding="30,26" Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Your Studio" Style="{StaticResource PageTitle}" />
                        <Label Text="Your pad, its agents, and what every input is set to do." Style="{StaticResource PageSubtitle}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            Style="{StaticResource TightCard}"
                            Padding="12,6"
                            VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                     Color="{Binding ConnectionColor}" VerticalOptions="Center" />
                            <Label Text="{Binding ConnectionText}" Style="{StaticResource ValueLabel}" FontSize="12" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,340" ColumnSpacing="18">
                    <!-- Pad map -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Creator Micro 2" Style="{StaticResource SectionTitle}" />
                                <Label Text="Tap any key, the dial or the joystick to run it, exactly as the pad would."
                                       Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>

                            <controls:PadMapView x:Name="DashboardPadMap"
                                                 HeightRequest="360"
                                                 KeyColors="{Binding KeyColorMap}"
                                                 AgentNames="{Binding AgentNames}"
                                                 Bindings="{Binding Bindings}" />

                            <Label Text="{Binding LastAction}" Style="{StaticResource CaptionLabel}"
                                   TextColor="{StaticResource StudioTextFaint}" />

                            <Button Text="Edit controls…"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding EditControlsCommand}"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Detail column -->
                    <VerticalStackLayout Grid.Column="1" Spacing="14">
                        <Border Style="{StaticResource TightCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="CONNECTION" Style="{StaticResource CardEyebrow}" />
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                             Color="{Binding ConnectionColor}" VerticalOptions="Center" />
                                    <Label Text="Creator Micro 2" Style="{StaticResource ValueLabel}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding StatusText}" Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource TightCard}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="AGENTS" Style="{StaticResource CardEyebrow}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Agents.Count, StringFormat='{0} live'}"
                                           Style="{StaticResource CaptionLabel}" TextColor="{StaticResource StudioTextFaint}" />
                                </Grid>

                                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Agents}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerRow}" Padding="10,8">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding FocusCommand}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                    <BoxView Grid.Column="0" WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                                             Color="{Binding StatusColor}" VerticalOptions="Center" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                                        <Label Text="{Binding ShortName}" Style="{StaticResource ValueLabel}" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding DirectoryName}" Style="{StaticResource CaptionLabel}"
                                                               FontSize="11" TextColor="{StaticResource StudioTextFaint}" LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="{Binding Status}" Style="{StaticResource CaptionLabel}"
                                                           TextColor="{Binding StatusColor}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource TightCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="STATUS" Style="{StaticResource CardEyebrow}" />
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                             Color="{StaticResource StudioGreen}" VerticalOptions="Center" />
                                    <Label Text="Idle" Style="{StaticResource CaptionLabel}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                             Color="{StaticResource StudioBlue}" VerticalOptions="Center" />
                                    <Label Text="Done" Style="{StaticResource CaptionLabel}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                             Color="{StaticResource StudioAmber}" VerticalOptions="Center" />
                                    <Label Text="Working" Style="{StaticResource CaptionLabel}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                             Color="{StaticResource StudioRed}" VerticalOptions="Center" />
                                    <Label Text="Needs you" Style="{StaticResource CaptionLabel}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <ContentView x:Name="ControlsHost" Grid.Column="1" IsVisible="{Binding IsControlsPage}" />
        <ContentView x:Name="LightingHost" Grid.Column="1" IsVisible="{Binding IsLightingPage}" />
        <ContentView x:Name="HerdrHost" Grid.Column="1" IsVisible="{Binding IsHerdrPage}" />

        <ScrollView Grid.Column="1" IsVisible="{Binding IsInspectorPage}">
            <VerticalStackLayout Spacing="20" Padding="30">
                <Label Text="Inspector" FontSize="26" FontAttributes="Bold" />
                <Label Text="Manual lighting is temporary. Leaving this page hands control back to Studio's saved lighting profile."
                       FontSize="12" TextColor="{StaticResource SecondaryColor}" />
            <BoxView HeightRequest="1" Color="{StaticResource SecondaryColor}" Margin="0,24,0,0" />
            <Label Text="Temporary manual lighting" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="By hand. Applying stops the bridge painting, so what you set stays."
                   FontSize="11" HorizontalOptions="Center" TextColor="{StaticResource SecondaryColor}" />

            <HorizontalStackLayout Spacing="6"
                                   HorizontalOptions="Center"
                                   BindableLayout.ItemsSource="{Binding Lights.Keys}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding Label}"
                                Command="{Binding SelectCommand}"
                                CommandParameter="{Binding .}"
                                WidthRequest="32"
                                HeightRequest="32"
                                Padding="0"
                                FontSize="11"
                                BackgroundColor="{Binding Background}"
                                TextColor="{Binding TextColor}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="Agent keys" Command="{Binding Lights.SelectAgentKeysCommand}" FontSize="11" Padding="10,4" />
                <Button Text="All" Command="{Binding Lights.SelectAllCommand}" FontSize="11" Padding="10,4" />
                <Button Text="None" Command="{Binding Lights.SelectNoneCommand}" FontSize="11" Padding="10,4" />
                <Label Text="{Binding Lights.SelectionText}"
                       FontSize="11"
                       VerticalOptions="Center"
                       TextColor="{StaticResource SecondaryColor}" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Colour" FontSize="12" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                    <Entry Text="{Binding Lights.ColorHex}" WidthRequest="88" FontSize="12" />
                    <Button Text="red" Command="{Binding Lights.UseColorCommand}" CommandParameter="#FF2D2D" FontSize="10" Padding="6,2" TextColor="#FF2D2D" />
                    <Button Text="amber" Command="{Binding Lights.UseColorCommand}" CommandParameter="#FFA000" FontSize="10" Padding="6,2" TextColor="#FFA000" />
                    <Button Text="blue" Command="{Binding Lights.UseColorCommand}" CommandParameter="#00B0FF" FontSize="10" Padding="6,2" TextColor="#00B0FF" />
                    <Button Text="green" Command="{Binding Lights.UseColorCommand}" CommandParameter="#00C853" FontSize="10" Padding="6,2" TextColor="#00C853" />
                    <Button Text="violet" Command="{Binding Lights.UseColorCommand}" CommandParameter="#7C4DFF" FontSize="10" Padding="6,2" TextColor="#7C4DFF" />
                    <Button Text="white" Command="{Binding Lights.UseColorCommand}" CommandParameter="#FFFFFF" FontSize="10" Padding="6,2" TextColor="#FFFFFF" />
                </HorizontalStackLayout>

                <Label Grid.Row="1" Grid.Column="0" Text="Effect" FontSize="12" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1"
                        FontSize="12"
                        ItemsSource="{Binding Lights.Effects}"
                        SelectedItem="{Binding Lights.Effect}" />

                <Label Grid.Row="2" Grid.Column="0" Text="Brightness" FontSize="12" VerticalOptions="Center" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,44">
                    <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Lights.Brightness}" />
                    <Label Grid.Column="1" Text="{Binding Lights.BrightnessText}" FontSize="11" VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="3" Grid.Column="0" Text="Speed" FontSize="12" VerticalOptions="Center" />
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,44">
                    <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Lights.Speed}" />
                    <Label Grid.Column="1" Text="{Binding Lights.SpeedText}" FontSize="11" VerticalOptions="Center" />
                </Grid>
            </Grid>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="Apply to selected" Command="{Binding Lights.ApplySelectedCommand}" FontSize="11" Padding="10,4" />
                <Button Text="Clear selected" Command="{Binding Lights.ClearSelectedCommand}" FontSize="11" Padding="10,4" />
                <Button Text="Whole keys zone" Command="{Binding Lights.ApplyKeysZoneCommand}" FontSize="11" Padding="10,4" />
            </HorizontalStackLayout>

            <Label Text="Underglow" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,12,0,0" />

            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Colour" FontSize="12" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                    <Entry Text="{Binding Lights.AmbientColorHex}" WidthRequest="88" FontSize="12" />
                    <Button Text="green" Command="{Binding Lights.UseAmbientColorCommand}" CommandParameter="#00C853" FontSize="10" Padding="6,2" TextColor="#00C853" />
                    <Button Text="red" Command="{Binding Lights.UseAmbientColorCommand}" CommandParameter="#FF2D2D" FontSize="10" Padding="6,2" TextColor="#FF2D2D" />
                    <Button Text="blue" Command="{Binding Lights.UseAmbientColorCommand}" CommandParameter="#00B0FF" FontSize="10" Padding="6,2" TextColor="#00B0FF" />
                    <Button Text="off" Command="{Binding Lights.UseAmbientColorCommand}" CommandParameter="#000000" FontSize="10" Padding="6,2" />
                </HorizontalStackLayout>

                <Label Grid.Row="1" Grid.Column="0" Text="Effect" FontSize="12" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1"
                        FontSize="12"
                        ItemsSource="{Binding Lights.Effects}"
                        SelectedItem="{Binding Lights.AmbientEffect}" />

                <Label Grid.Row="2" Grid.Column="0" Text="Brightness" FontSize="12" VerticalOptions="Center" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,44">
                    <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Lights.AmbientBrightness}" />
                    <Label Grid.Column="1" Text="{Binding Lights.AmbientBrightnessText}" FontSize="11" VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="3" Grid.Column="0" Text="Speed" FontSize="12" VerticalOptions="Center" />
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,44">
                    <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Lights.AmbientSpeed}" />
                    <Label Grid.Column="1" Text="{Binding Lights.AmbientSpeedText}" FontSize="11" VerticalOptions="Center" />
                </Grid>
            </Grid>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="Apply underglow" Command="{Binding Lights.ApplyUnderglowCommand}" FontSize="11" Padding="10,4" />
                <Button Text="All lights off" Command="{Binding Lights.AllOffCommand}" FontSize="11" Padding="10,4" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0">
                <Switch IsToggled="{Binding Lights.IsManual}" />
                <Label Text="Take the lights off the bridge" FontSize="12" VerticalOptions="Center" />
            </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
